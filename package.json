{
  "name": "wcdocmanager",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "node --watch --env-file-if-exists=.env --import tsx src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "tsx src/cli/index.ts",
    "cli:install": "scripts/install-cli.sh"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
